{
	"name": "auth-client-better-auth-sample",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm --filter \"auth-client-better-auth-sample^...\" run build && tsc -b && vite build",
		"lint": "oxlint",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"generate-migration": "better-auth generate --config auth.cli.ts --output migrations/0001_init.sql --yes",
		"migrate:local": "wrangler d1 migrations apply DB --local",
		"migrate:remote": "wrangler d1 migrations apply DB --remote",
		"migrate:preview": "wrangler d1 migrations apply DB --preview --remote"
	},
	"dependencies": {
		"@concrnt/better-auth": "workspace:*",
		"better-auth": "^1.7.14",
		"kysely": "^0.29.7",
		"kysely-d1": "^0.4.0",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@types/node": "^26.6.5",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"oxlint": "^1.81.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.0",
		"wrangler": "^4.153.0"
	}
}
