{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-client-sample",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-19",
	"assets": {
		"not_found_handling": "single-page-application",
		// /auth/* (送り先 URL = post の受け口と fragment の着地ページ) と /api/* は Worker が返す。
		// これが無いと compatibility_date >= 2025-04-01 では navigation GET が Worker を通らず index.html になる
		"run_worker_first": ["/api/*", "/auth/*"]
	},
	// 公開 URL。カスタムドメインだけで配信し、*.workers.dev は無効にする (RP のオリジンが 1 つに定まる)
	"routes": [{ "pattern": "auth-client-sample.concrnt.net", "custom_domain": true }],
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// 状態は D1 だけ: ライブラリの AuthStore (要求の行・別端末フローの結果。数分で消える) と、ログイン後のセッション。
	// 別のアカウントにデプロイするときは `wrangler d1 create auth-client-sample` で作って database_id を差し替え、
	// `pnpm migrate:remote` でスキーマを入れる。ローカル開発 (pnpm dev) は id ごとにエミュレートされる (`pnpm migrate:local`)。
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth-client-sample",
			"database_id": "b7addcd0-ae41-4997-a56a-dfe2a1c52aed",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// RP のオリジン。送り先 URL (= RP の識別子・ID Token の aud、CIP-17 §5.1) は `${origin}/auth/callback`。Authorization Request URI には
		// host/path しか載らず https が暗黙なので http では成立しない (Authenticator が http で送ってよいのは localhost だけ)。
		// 空ならリクエストのオリジンを使う。ローカル開発でトンネル等を使うときは .dev.vars で上書きする。
		"PUBLIC_ORIGIN": ""
	}
}
